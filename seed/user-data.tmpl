#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Asia/Hong_Kong
  network:
    version: 2
    ethernets:
      any-en:
        match:
          name: "en*"
        dhcp4: true
      any-eth:
        match:
          name: "eth*"
        dhcp4: true
  identity:
    hostname: lisa
    username: deyao
    password: '@PASSWORD_HASH@'
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
@AUTHORIZED_KEYS@
  storage:
    layout:
      name: direct
  late-commands:
    # Set timezone deterministically at install time (the first-boot cloud-init
    # timezone module is unreliable on runners where cloud-init is disabled
    # post-install).
    - bash -c 'ln -sf /usr/share/zoneinfo/Asia/Hong_Kong /target/etc/localtime && echo Asia/Hong_Kong > /target/etc/timezone'
    # Cloud-image convention: the account password is random and discarded at
    # build time; access is SSH-key-only with passwordless sudo.
    - bash -c 'printf "deyao ALL=(ALL) NOPASSWD:ALL\n" > /target/etc/sudoers.d/90-deyao && chmod 440 /target/etc/sudoers.d/90-deyao'
    - bash -c 'cp /cdrom/nocloud/payload/lisa-wifi-setup /target/usr/local/sbin/lisa-wifi-setup && chmod 755 /target/usr/local/sbin/lisa-wifi-setup'
    - bash -c 'cp /cdrom/nocloud/payload/lisa-wifi-setup.service /target/etc/systemd/system/lisa-wifi-setup.service && ln -sf /etc/systemd/system/lisa-wifi-setup.service /target/etc/systemd/system/multi-user.target.wants/lisa-wifi-setup.service'
    - bash -c 'if compgen -G "/cdrom/nocloud/debs/*.deb" > /dev/null; then mkdir -p /target/opt/lisa-debs && cp /cdrom/nocloud/debs/*.deb /target/opt/lisa-debs/ && curtin in-target --target=/target -- bash -c "DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Dir::Etc::sourcelist=/dev/null -o Dir::Etc::sourceparts=/dev/null /opt/lisa-debs/*.deb" && rm -rf /target/opt/lisa-debs; fi'
  shutdown: poweroff
  user-data:
    timezone: Asia/Hong_Kong
    write_files:
      - path: /etc/lisa-tskey
        permissions: "0600"
        owner: root:root
        content: "@TS_AUTHKEY@"
      - path: /usr/local/sbin/lisa-tailscale-join
        permissions: "0755"
        owner: root:root
        content: |
          #!/bin/sh
          # Joins this machine to the tailnet. Retries within a boot and, via the
          # systemd unit's ConditionPathExists, across boots until it succeeds.
          set -u
          [ -f /etc/lisa-tskey ] || exit 0
          i=0
          while [ $i -lt 30 ]; do
            i=$((i + 1))
            if ! command -v tailscale >/dev/null 2>&1; then
              curl -fsSL https://tailscale.com/install.sh | sh || { sleep 10; continue; }
            fi
            if tailscale up --authkey "$(cat /etc/lisa-tskey)"; then
              rm -f /etc/lisa-tskey
              systemctl disable lisa-tailscale-join.service
              exit 0
            fi
            sleep 10
          done
          exit 1
      - path: /etc/systemd/system/lisa-tailscale-join.service
        permissions: "0644"
        owner: root:root
        content: |
          [Unit]
          Description=Join tailnet on first boot (lisa installer)
          Wants=network-online.target
          After=network-online.target
          ConditionPathExists=/etc/lisa-tskey

          [Service]
          Type=oneshot
          ExecStart=/usr/local/sbin/lisa-tailscale-join
          TimeoutStartSec=900

          [Install]
          WantedBy=multi-user.target
    runcmd:
      - [systemctl, daemon-reload]
      - [systemctl, enable, --now, --no-block, lisa-tailscale-join.service]
